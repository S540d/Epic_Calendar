    "expo": "~57.0.0",
    "expo-asset": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.13",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.6.0",
